                "exec": [
                  "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Чужой токен устройства → Problem 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Device-Token",
                "value": "dvt_stolen"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{gateway}}/device/v1/recordings",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                "device",
                "v1",
                "recordings"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "audio",
                  "type": "file",
                  "src": "demo/audio/01_out_of_stock.ogg"
                },
                {
                  "key": "startedAt",
                  "value": "{{$isoTimestamp}}",
                  "type": "text"
                },
                {
                  "key": "durationSec",
                  "value": "30",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"problem+json\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Валидация → Problem 400",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway}}/api/v1/incidents?venueId=not-uuid&from={{date}}&to={{date}}",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                "api",
                "v1",
                "incidents"
              ],
              "query": [
                {
                  "key": "venueId",
                  "value": "not-uuid"
                },
                {
                  "key": "from",
                  "value": "{{date}}"
                },
                {
                  "key": "to",
                  "value": "{{date}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// дата отчёта = текущая дата UTC (startedAt фрагментов в UTC)",
          "pm.collectionVariables.set('date', new Date().toISOString().slice(0, 10));"
        ]
      }
    }
  ]
}